# Copy to .env and fill in. Never commit the real .env.

# Database (local development uses SQLite)
DATABASE_URL="file:./dev.db"

# Session signing secret — at least 32 random characters (required in production)
AUTH_SECRET=""

# Public address of the site (used for links, payment return URLs and webhooks)
APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# AI patient: "anthropic", "groq" or "demo" (offline scripted engine)
AI_PROVIDER="demo"
ANTHROPIC_API_KEY=""

# Payments: "sofizpay" (default), "demo" or "stripe"
PAYMENT_PROVIDER="sofizpay"
# SofizPay receiving account (public address, starts with G)
SOFIZPAY_ACCOUNT=""

# Optional
# ENABLE_DEMO_LOGIN="false"
# RESEND_API_KEY=""
# EMAIL_FROM="DiagnoCare <no-reply@example.com>"
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
